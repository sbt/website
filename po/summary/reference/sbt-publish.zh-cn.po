#: src/reference/reference/sbt-publish.md:6
msgid "sbt publish"
msgstr "sbt publish"

#: src/reference/reference/sbt-publish.md:9
msgid "Synopsis"
msgstr "概要"

#: src/reference/reference/sbt-publish.md:12
msgid ""
"`sbt` \\[_query_ / \\] `publish`<br> `sbt` \\[_query_ / \\] "
"`publishSigned`<br> `sbt` \\[_query_ / \\] `publishLocal`<br> `sbt` \\"
"[_query_ / \\] `publishM2`"
msgstr ""
"`sbt` \\[_query_ / \\] `publish`<br> `sbt` \\[_query_ / \\] "
"`publishSigned`<br> `sbt` \\[_query_ / \\] `publishLocal`<br> `sbt` \\"
