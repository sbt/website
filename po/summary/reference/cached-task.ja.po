msgstr ""

#: src/reference/reference/cached-task.md:52
msgid ""
"To opt out of by-default custom task caching, add the following to `project/"
"plugins.sbt`:"
msgstr ""

#: src/reference/reference/cached-task.md:55
msgid "\"-Xmacro-settings:sbt:no-default-task-cache\""
msgstr ""

#: src/reference/reference/cached-task.md:58
msgid ""
"```admonish note\n"
"This applies only to the custom tasks introduced in the build. Any cached "
"tasks provided by sbt or plugins will remain cached.\n"
"```"
msgstr ""

