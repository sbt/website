#: src/reference/reference/sbt-dependency-tree.md:78
msgid "GraphViz DOT File"
msgstr ""

#: src/reference/reference/sbt-dependency-tree.md:80
msgid "Generates a DOT file for rendering graphs (e.g., with `dot` command)."
msgstr ""

#: src/reference/reference/sbt-dependency-tree.md:86
msgid "Contents of `dependencies.dot`:"
msgstr ""

#: src/reference/reference/sbt-dependency-tree.md:88
msgid ""
"```\n"
"digraph \"dependency-graph\" {\n"
"    graph[rankdir=\"LR\"; splines=polyline]\n"
"    edge [arrowtail=\"none\"]\n"
"    \"default:example_3:0.1.0-SNAPSHOT\" -> \"org.scala-lang:scala3-"
"library_3:3.3.1\"\n"
"    \"default:example_3:0.1.0-SNAPSHOT\" -> \"com.example:library_3:1.0.0\"\n"
"    \"com.example:library_3:1.0.0\" -> \"org.typelevel:cats-core_3:2.9.0\"\n"
"    // ... more edges\n"
"}\n"
"```"
msgstr ""

#: src/reference/reference/sbt-dependency-tree.md:99
