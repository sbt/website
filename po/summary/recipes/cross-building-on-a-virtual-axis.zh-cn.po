#: src/reference/recipes/virtual-axis.md:1
msgid "Cross building on a virtual axis"
msgstr "在虚拟轴上交叉构建"

#: src/reference/recipes/virtual-axis.md:4
msgid ""
"```admonish note\n"
"The recipe section of the documentation focuses on the objectives\n"
"with minimal explanations.\n"
"```"
msgstr ""
"```admonish note\n"
"文档中的食谱部分以最少说明聚焦于目标。\n"
"```"

#: src/reference/recipes/virtual-axis.md:9
msgid "Objective"
msgstr "目标"

#: src/reference/recipes/virtual-axis.md:12
msgid ""
"I want to cross build on a virtual axis that represents Apache Spark version."
msgstr "我想在表示 Apache Spark 版本的虚拟轴上进行交叉构建。"

#: src/reference/recipes/virtual-axis.md:14
msgid "Steps"
msgstr "步骤"

#: src/reference/recipes/virtual-axis.md:17
msgid "Define a weak axis locally:"
msgstr "在本地定义弱轴："

#: src/reference/recipes/virtual-axis.md:19
msgid ""
"````admonish example title=\"project/Axis.scala\"\n"
"```scala\n"
"import sbt.*\n"
"\n"
"case class SparkAxis(idSuffix: String, directorySuffix: String)\n"
"  extends VirtualAxis.WeakAxis\n"
"```\n"
"````"
msgstr ""

#: src/reference/recipes/virtual-axis.md:28
msgid ""
"Define a project matrix with custom rows. The following builds Scala 2.12 "
"and 2.13 for Spark 3, and Scala 2.13 and 3 for Spark 4:"
msgstr ""
"定义带自定义行的项目矩阵。以下示例为 Spark 3 构建 Scala 2.12 和 2.13，为 "
"Spark 4 构建 Scala 2.13 和 3："

#: src/reference/recipes/virtual-axis.md:30
msgid ""
"````admonish example title=\"build.sbt\"\n"
"```scala\n"
"lazy val scala212 = \"2.12.21\"\n"
"lazy val scala213 = \"2.13.18\"\n"
"lazy val scala3 = \"3.8.4\"\n"
"lazy val spark3 = SparkAxis(idSuffix = \"Spark3\", directorySuffix = "
"\"spark3\")\n"
"lazy val spark4 = SparkAxis(idSuffix = \"Spark4\", directorySuffix = "
"\"spark4\")\n"
"\n"
"organization := \"com.example\"\n"
"version := \"0.1.0-SNAPSHOT\"\n"
"\n"
"lazy val app = (projectMatrix in file(\"app\"))\n"
"  .settings(\n"
"    name := \"app\"\n"
"  )\n"
"  .customRow(\n"
"    scalaVersions = Seq(scala212, scala213),\n"
"    axisValues = Seq(spark3, VirtualAxis.jvm),\n"
"    settings = Seq(\n"
"      moduleName := name.value + \"_spark3\",\n"
"      libraryDependencies += \"org.apache.spark\" %% \"spark-core\" % "
"\"3.5.8\",\n"
"    )\n"
"  )\n"
"  .customRow(\n"
"    scalaVersions = Seq(scala213, scala3),\n"
"    axisValues = Seq(spark4, VirtualAxis.jvm),\n"
"    settings = Seq(\n"
"      moduleName := name.value + \"_spark4\",\n"
"      libraryDependencies += (\"org.apache.spark\" %% \"spark-core\" % "
"\"4.1.0\")\n"
"        .cross(CrossVersion.for3Use2_13),\n"
"    )\n"
"  )\n"
"```\n"
"````"
msgstr ""

#: src/reference/recipes/virtual-axis.md:65
msgid "Place the source code under `app/src/main/scala`:"
msgstr "将源代码放在 `app/src/main/scala` 下："

#: src/reference/recipes/virtual-axis.md:68
msgid ""
"````admonish example title=\"app/src/main/scala/example/A.scala\"\n"
"```scala\n"
"package example\n"
"\n"
"import org.apache.spark.SparkContext\n"
"\n"
"object A {\n"
"  def main(args: Array[String]): Unit = {\n"
"    val sc = new SparkContext(\"local\", \"test\")\n"
"    sc.stop()\n"
"  }\n"
"}\n"
"```\n"
"````"
msgstr ""

